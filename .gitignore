# Exclude all README files (any case, any extension)
**/README*
**/readme*
**/*README*
**/*readme*

# Exclude all JAR files
**/*.jar

# Common build artifacts (optional but recommended)
**/target/
**/build/
**/.classpath
**/.project
**/.settings/
**/*.class
**/bin/

# IDE files (optional)
**/.idea/
**/*.iml
**/.vscode/
**/.eclipse/

# OS files
.DS_Store
Thumbs.db

# Maven/Gradle temp files (but keep the structure)
**/maven-temp/
**/.gradle/
**/gradle-wrapper/

# Excluded plugins/folders
plugins/PandoraBases/
plugins/bloodmoon-master/
plugins/WorldBorder-master/
plugins/SimpleScore-main/
plugins/LevelledMobs-maste/
plugins/AuraSkills-master/
ranks/SlimeRanks-master/

